  {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Ejecutar React App",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/node_modules/react-scripts/bin/react-scripts.js",
        "args": ["start"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "runtimeExecutable": "node",
        "env": {
          "BROWSER": "chrome"
        }
      }
    ]
  }
  